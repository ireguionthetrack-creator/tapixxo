# Wompi is Sandbox-only in this phase. Never commit real credentials to .env.local.
WOMPI_ENVIRONMENT=sandbox
WOMPI_SANDBOX_PUBLIC_KEY=pub_test_replace_with_your_sandbox_public_key
WOMPI_SANDBOX_INTEGRITY_SECRET=replace_with_your_sandbox_integrity_secret
WOMPI_SANDBOX_EVENTS_SECRET=replace_with_your_sandbox_events_secret

# Public HTTPS Vercel URL used for Wompi's redirect URL and Sandbox webhook tests.
TAPIXXO_APP_URL=https://your-controlled-vercel-domain.vercel.app
